    "@types/node-fetch": "^2.6.11",
    "algoliasearch": "^4.12.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^10.0.2",
    "formik": "^2.2.9",
    "instantsearch.css": "^7.4.5",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
