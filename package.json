{
  "name": "readme-arkiv-v2",
  "private": true,
  "scripts": {
    "predev": "yarn build:service-worker",
    "dev": "next dev",
    "prebuild": "yarn build:service-worker",
    "build": "next build",
    "build:service-worker": "tsc --project service-workers/tsconfig.json && esbuild service-workers/firebase-auth.worker.ts --bundle --outfile=public/firebase-auth-service-worker.js --format=iife --platform=browser --target=es2020",
    "start": "next start",
    "emulators": "yarn --cwd ./functions build && firebase emulators:start --import=./firebase-fixtures",
    "lint": "eslint ."
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
